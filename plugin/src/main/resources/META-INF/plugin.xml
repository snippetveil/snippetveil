<!-- Plugin descriptor. sinceBuild/untilBuild are patched in from plugin/build.gradle.kts. -->
<idea-plugin>
    <!-- Immutable after publication. Do not change it, ever. -->
    <id>com.snippetveil</id>
    <name>SnippetVeil</name>

    <!-- Vendor email is a @snippetveil.com forwarding address; it is set up in snippetveil/snippetveil#22,
         together with the domain, and both must resolve before the first Marketplace upload. -->
    <vendor email="hello@snippetveil.com" url="https://snippetveil.com">Fyodor Skorozhenko</vendor>

    <!-- **There is no `<description>` here, and that is the mechanism rather than an omission.**
         The descriptor's description is patched in from the listing-copy block in README.md by
         `plugin/build.gradle.kts`, so the Marketplace listing and the README are the same strings
         rather than two texts making the same claim. A `<description>` written here would be
         overwritten by the patch, which is the failure worth designing out: a second copy that
         looks authoritative, reads differently, and ships neither. `assertTheListingCopyIsTheReadme`
         fails the build if the description in the built distribution ever stops being that block.

         The Plugin Verifier rejects a descriptor without a description; what it verifies is the
         patched one. -->

    <!-- The bundled Java plugin: IDEA Community/Ultimate and Android Studio, nowhere else. -->
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- A group of SnippetVeil's own, so that a user who does not want these balloons can turn
             off exactly these and nothing else. -->
        <notificationGroup id="SnippetVeil" displayType="BALLOON"/>

        <!-- **projectConfigurable, not applicationConfigurable**, because the one setting the page
             edits is inherently per-repository: a different employer means a different group id, and
             a single global page would offer to write one project's vocabulary into the next one's
             analysis. Under Tools, which is where this plugin's menu already is. -->
        <projectConfigurable
            id="com.snippetveil.settings"
            parentId="tools"
            displayName="SnippetVeil"
            instance="com.snippetveil.plugin.SnippetVeilConfigurable"/>

        <!-- The one time the plugin speaks without being asked. The surface is deliberately
             invisible — no toolbar button, no tool window, no default shortcut, no menu entry
             outside a Java editor — and together those make install-and-never-notice the realistic
             failure mode. One balloon, on the first project opened after installing, shown once
             ever; a post-install web page is refused outright, since a plugin selling "no network
             connections" cannot open one on day one. -->
        <postStartupActivity implementation="com.snippetveil.plugin.FirstRunAnnouncement"/>
    </extensions>

    <actions>
        <!-- No <keyboard-shortcut>, and that is a decision rather than an omission. Every
             combination worth having is taken, differently across the Default, macOS, Eclipse and
             VS Code keymaps — so a binding that is clean on one machine ships a conflict badge on
             another, which reads as carelessness from a plugin selling carefulness. Find Action
             already serves the population that wants one. -->
        <action id="SnippetVeil.CopyAnonymized"
                class="com.snippetveil.plugin.CopyAnonymizedAction"
                text="Copy Anonymized"
                description="Copy the selection with project-owned names replaced by placeholders"/>

        <!-- The same invocation, stopped at a dialog. Two actions rather than one that always asks:
             preview-first taxes the common case to protect against a risk that does not exist on
             that path. The ellipsis is the platform's own convention for an item that opens a
             dialog, and here it is load-bearing — the difference between these two items is
             precisely whether one opens. -->
        <action id="SnippetVeil.AnonymizeWithPreview"
                class="com.snippetveil.plugin.AnonymizeWithPreviewAction"
                text="Anonymize with Preview&#8230;"
                description="Show the anonymized selection and its mapping before copying it"/>

        <!-- The other direction. It reads no source at all, so unlike the two above it is offered
             on every file type — a reply gets pasted into a scratch buffer, a Markdown file or a
             commit message, and a Java gate here would make the item wrong on the file the user
             actually has open. -->
        <action id="SnippetVeil.DeanonymizeClipboard"
                class="com.snippetveil.plugin.DeanonymizeClipboardAction"
                text="De-anonymize Clipboard"
                description="Replace SnippetVeil placeholders in the clipboard with the real names"/>

        <!-- The same reversal, delivered to the caret instead of the clipboard. A fourth row rather
             than a modifier on the item above it, or a checkbox: a modifier makes one gesture do two
             things with nothing on screen to say which, and a setting makes it depend on state the
             user cannot see at the moment they invoke — both unacceptable for the one item here that
             writes into source code.

             **It is not the item above with a paste bolted on, and three of its decisions differ.**
             It needs a writable editor, where the reversal needs only a project. It refuses to write
             anything it did not fully restore, because the sibling's tolerated no-op puts unrestored
             placeholders on a clipboard the user reads and this one would put them in a file. And it
             leaves the clipboard holding the anonymized reply, so quoting the AI back still works.

             No <keyboard-shortcut> here either. This is precisely the item that tempts one, and the
             decision recorded above is not reopened by a new row. -->
        <action id="SnippetVeil.DeanonymizeClipboardAndPaste"
                class="com.snippetveil.plugin.DeanonymizeClipboardAndPasteAction"
                text="De-anonymize Clipboard and Paste"
                description="Replace SnippetVeil placeholders in the clipboard with the real names and insert the result at the caret"/>

        <!-- **One group, two homes.** The same submenu is added to the Tools menu and to the editor
             popup, so the two placements cannot drift into two different menus: an action added
             here appears in both, in the same order, with the same gating, because it is the same
             group rather than a copy of one.

             **A submenu in the editor popup rather than flat items.** The earlier arrangement put
             the two anonymizing actions directly in the popup, on the reasoning that a copy belongs
             where the other copies are. That reasoning does not survive a third item: `Copy
             Anonymized` and `Anonymize with Preview…` are gated to Java files and this one is not,
             so flat placement would put a SnippetVeil item in every editor popup in the IDE —
             Markdown, JSON, scratch buffers, everything. One named submenu costs the anonymizing
             actions a hover and keeps the global context menu the size it was.

             The group is never empty where it is shown: `De-anonymize Clipboard` needs only a
             project, and an editor popup implies one. That still holds now that a fourth item can be
             disabled — `De-anonymize Clipboard and Paste` needs a writable editor, so it greys out
             in a Tools menu opened with nothing open, and the item above it is what keeps the
             submenu from being empty there. Greying out rather than hiding is what lets this stay
             one group: an item hidden in one parent and shown in the other would be two submenus
             wearing one name. -->
        <group id="SnippetVeil.Menu" text="SnippetVeil" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <!-- Anchored after the Copy/Paste Special group, which is where the anonymizing actions
                 sat when they were flat: the submenu keeps their place in the menu even though it
                 no longer keeps their level. -->
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Copy.Paste.Special"/>

            <reference ref="SnippetVeil.CopyAnonymized"/>
            <reference ref="SnippetVeil.AnonymizeWithPreview"/>
            <reference ref="SnippetVeil.DeanonymizeClipboard"/>
            <reference ref="SnippetVeil.DeanonymizeClipboardAndPaste"/>
        </group>
    </actions>
</idea-plugin>
